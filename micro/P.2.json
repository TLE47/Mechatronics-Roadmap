      "id": "order-of-operations",
      "title": "Parentheses are the shape of the formula",
      "parentLessonId": "P.2",
      "anchor": "micro-order-of-operations",
      "sourceFocus": [
        "Python evaluates **Parentheses `()`** first",
        "then **Exponents `**`**"
      ],
      "revision": 1,
      "prerequisites": [
        "operators"
      ],
      "resources": [
        {
          "id": "mathisfun-order",
          "title": "MathsIsFun — Order of operations",
