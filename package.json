{
  "name": "mechalab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "python3 scripts/generate_python_lessons_data.py",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "prebuild": "python3 scripts/generate_python_lessons_data.py",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "check:lessons": "python3 scripts/generate_python_lessons_data.py --check",
    "check:linkhistory": "python3 scripts/generate_link_history_data.py --check",
    "test:linkhistory": "python3 tests/test_link_history_data.py",
    "check:ramp": "python3 scripts/check_ramp_lessons.py --json",
    "check:stepsize": "python3 scripts/audit_step_size.py --check",
    "check:crosswalk": "python3 scripts/legacy_crosswalk.py --check",
    "check:mentions": "python3 scripts/mentions_audit.py --check",
    "check:parity": "python3 scripts/module_parity.py --check",
    "check:ladder": "python3 scripts/generate_ladder_gate.py --check",
    "check:skip": "python3 scripts/generate_skip_tests.py --check",
    "test:skip": "python3 tests/test_skip_tests.py",
    "test:lessonlint": "python3 tests/test_lint_lessons.py",
    "test:reentry": "python3 tests/test_reentry.py",
    "check:friction": "python3 scripts/friction_report.py --check",
    "check:all": "python3 scripts/check_all.py",
    "check:all:full": "python3 scripts/check_all.py --full",
    "test:friction": "python3 tests/test_friction_report.py",
    "check:assertions": "python3 scripts/lint_assertions.py",
    "test:assertions": "python3 tests/test_lint_assertions.py",
    "test:linkscan": "python3 tests/test_link_scan_set.py",
    "test:bridges": "python3 tests/test_track_bridge_lists.py",
    "test:linkcache": "python3 tests/test_link_cache.py",
    "links:revalidate": "python3 scripts/check_links.py --revalidate-unverified --jobs 8",
    "check:route": "python3 scripts/generate_sim_route.py --check",
    "check:spine": "python3 scripts/generate_spine_data.py --check",
    "test:spine": "node --experimental-strip-types scripts/test_spine.mjs",
    "check:starthere": "python3 scripts/generate_start_here.py --check",
    "check:callout": "python3 scripts/generate_run_callouts.py --check",
    "test:callout": "python3 tests/test_run_callout.py",
    "check:tabnames": "python3 scripts/check_tab_names.py",
    "test:tabnames": "python3 tests/test_tab_names.py",
    "test:practice": "node --experimental-strip-types scripts/test_practice_links.mjs",
    "test:parity": "python3 tests/test_module_parity.py",
    "check:plant": "python3 scripts/generate_plant_data.py --check",
    "test:plant": "python3 tests/test_plant.py",
    "test:models": "python3 tests/test_model_levels.py",
    "check:exercises": "python3 scripts/run_exercise.py",
    "test:exercise": "python3 tests/test_exercise_package.py",
    "check:native": "node scripts/check_native_deps.mjs",
    "test:smoke": "node scripts/smoke_test_workbench.mjs",
    "test:workbench": "node scripts/test_workbench.mjs",
    "test:e2e": "node scripts/e2e_browser_workbench.mjs",
    "test:e2e:pages": "node scripts/e2e_pages_bundle.mjs",
    "verify:walls": "node scripts/verify_bot_walls.mjs",
    "test:merge": "node --experimental-strip-types scripts/test_progress_merge.mjs",
    "test:faultbench": "node --experimental-strip-types scripts/test_fault_bench.mjs",
    "test:pairs": "node scripts/e2e_same_task_pairs.mjs",
    "test:tour": "node scripts/e2e_tour_presets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
