<mujoco model="capstone2_furuta_pendulum">
  <compiler angle="radian" coordinate="local" inertiafromgeom="false"/>
  <option timestep="0.0005" integrator="RK4" gravity="0 0 -9.80665"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.005 0.0001"/>
    <joint limited="true" armature="0.00012"/>
  </default>

  <worldbody>
    <light name="top_light" pos="0 0 1.5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.05" rgba="0.12 0.16 0.22 1" contype="1" conaffinity="1"/>

    <!-- Fixed Stator Pedestal Base -->
    <body name="base_link" pos="0 0 0">
      <inertial pos="0 0 0.06" mass="2.500" diaginertia="0.008500 0.008500 0.009000"/>
      <geom name="base_pedestal" type="cylinder" pos="0 0 0.06" size="0.085 0.06" rgba="0.18 0.22 0.28 1"/>

      <!-- Link 1: Actuated Horizontal Rotary Arm -->
      <body name="rotary_arm_link" pos="0 0 0.14">
        <joint name="q1_base_yaw" type="hinge" axis="0 0 1" range="-2.0943951 2.0943951" damping="0.0015" frictionloss="0.002" armature="0.00025"/>
        <inertial pos="0.09 0 0" mass="0.320" diaginertia="0.000031 0.000879 0.000879"/>
        <geom name="rotary_arm_geom" type="capsule" fromto="0 0 0 0.18 0 0" size="0.012" rgba="0.75 0.78 0.82 1"/>
        <site name="pivot_encoder_site" pos="0.18 0 0" size="0.008" rgba="0.22 0.74 0.97 1"/>

        <!-- Link 2: Unactuated Vertical Pendulum Link (q2 = 0 is upright +Z) -->
        <body name="pendulum_link" pos="0.18 0 0">
          <joint name="q2_pendulum_pitch" type="hinge" axis="1 0 0" limited="false" damping="0.00008" frictionloss="0.00005" armature="0.000005"/>
          <inertial pos="0 0 0.15" mass="0.145" diaginertia="0.000820 0.000820 0.000012"/>
          <geom name="pendulum_rod_geom" type="capsule" fromto="0 0 0 0 0 0.26" size="0.006" rgba="0.12 0.65 0.45 1"/>

          <!-- Tip Bob & Site -->
          <body name="pendulum_tip_link" pos="0 0 0.26">
            <inertial pos="0 0 0" mass="0.010" diaginertia="0.000001 0.000001 0.000001"/>
            <geom name="tip_bob_geom" type="sphere" pos="0 0 0" size="0.015" rgba="0.92 0.72 0.18 1"/>
            <site name="pendulum_tip_site" pos="0 0 0" size="0.006" rgba="1 0.3 0.3 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Direct-Drive Brushless Torque Motor on Base Joint ONLY (Underactuated) -->
    <motor name="q1_torque_motor" joint="q1_base_yaw" gear="1.0" ctrllimited="true" ctrlrange="-4.5 4.5"/>
  </actuator>

  <sensor>
    <jointpos name="enc_q1_pos" joint="q1_base_yaw" noise="0.00005"/>
    <jointvel name="enc_q1_vel" joint="q1_base_yaw" noise="0.002"/>
    <jointpos name="enc_q2_pos" joint="q2_pendulum_pitch" noise="0.0001"/>
    <jointvel name="enc_q2_vel" joint="q2_pendulum_pitch" noise="0.005"/>
    <framepos name="tip_cartesian_pos" objtype="site" objname="pendulum_tip_site"/>
  </sensor>
</mujoco>
