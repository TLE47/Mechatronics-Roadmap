<?xml version="1.0" encoding="utf-8"?>
<!--
  Capstone II: Underactuated Rotary Inverted Pendulum (Furuta Pendulum)
  - Joint 1 (q1_base_yaw): Direct-Drive Brushless Motor about vertical +Z axis
  - Joint 2 (q2_pendulum_pitch): Unactuated Ceramic-Bearing Pendulum about radial +X axis
  - All inertia tensors verified SPD and strictly satisfy triangle inequalities.
-->
<robot name="capstone2_furuta_pendulum">

  <material name="anodized_slate">
    <color rgba="0.18 0.22 0.28 1.0"/>
  </material>
  <material name="machined_aluminum">
    <color rgba="0.75 0.78 0.82 1.0"/>
  </material>
  <material name="carbon_rod">
    <color rgba="0.12 0.65 0.45 1.0"/>
  </material>
  <material name="brass_tip">
    <color rgba="0.92 0.72 0.18 1.0"/>
  </material>

  <!-- Fixed Stator Pedestal Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/>
      <mass value="2.500"/>
      <inertia ixx="0.008500" ixy="0.0" ixz="0.0" iyy="0.008500" iyz="0.0" izz="0.009000"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.085" length="0.12"/>
      </geometry>
      <material name="anodized_slate"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.085" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: Actuated Direct-Drive Base Rotary Arm (+Z axis) -->
  <joint name="q1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="rotary_arm_link"/>
    <origin xyz="0.0 0.0 0.14" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="4.5" velocity="25.0"/>
    <dynamics damping="0.0015" friction="0.002"/>
  </joint>

  <!-- Horizontal Rotary Arm (Length L1 = 0.18 m along +X) -->
  <link name="rotary_arm_link">
    <inertial>
      <origin xyz="0.09 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.320"/>
      <!-- Solid aluminum bar 0.18m x 0.024m x 0.024m about CoM -->
      <inertia ixx="0.000031" ixy="0.0" ixz="0.0" iyy="0.000879" iyz="0.0" izz="0.000879"/>
    </inertial>
    <visual>
      <origin xyz="0.09 0.0 0.0" rpy="0.0 1.57079632679 0.0"/>
      <geometry>
        <cylinder radius="0.012" length="0.18"/>
      </geometry>
      <material name="machined_aluminum"/>
    </visual>
    <collision>
      <origin xyz="0.09 0.0 0.0" rpy="0.0 1.57079632679 0.0"/>
      <geometry>
        <cylinder radius="0.012" length="0.18"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Unactuated Low-Friction Pendulum Pivot (+X radial axis, q2=0 upright +Z) -->
  <joint name="q2_pendulum_pitch" type="continuous">
    <parent link="rotary_arm_link"/>
    <child link="pendulum_link"/>
    <origin xyz="0.18 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="1.0 0.0 0.0"/>
    <limit effort="0.0" velocity="60.0"/>
    <dynamics damping="0.00008" friction="0.00005"/>
  </joint>

  <!-- Vertical Pendulum Rod + Tip Mass (Length L2 = 0.26 m, CoM at lc2 = 0.15 m along +Z) -->
  <link name="pendulum_link">
    <inertial>
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
      <mass value="0.145"/>
      <!-- Slender rod + tip bob about CoM: Ixx = Iyy = 0.000820, Izz = 0.000012 -->
      <inertia ixx="0.000820" ixy="0.0" ixz="0.0" iyy="0.000820" iyz="0.0" izz="0.000012"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.13" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.006" length="0.26"/>
      </geometry>
      <material name="carbon_rod"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.13" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.006" length="0.26"/>
      </geometry>
    </collision>
  </link>

  <!-- End-Effector / Tip Marker Frame for Tracking & Energy Logging -->
  <joint name="pendulum_tip_fixed" type="fixed">
    <parent link="pendulum_link"/>
    <child link="pendulum_tip_link"/>
    <origin xyz="0.0 0.0 0.26" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="pendulum_tip_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.010"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="brass_tip"/>
    </visual>
  </link>

  <transmission name="q1_direct_drive_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="q1_base_yaw">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="q1_bldc_motor">
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

</robot>
