{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechalab.dev/schemas/parts.schema.json",
  "title": "MechaLab robot parts",
  "description": "content/arm/parts.json: the parts a mission seats on H-7, and the few individual lessons that own a real assembly. A part is never invented per page.",
  "type": "object",
  "required": ["version", "parts"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "parts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "mission", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 40 },
          "mission": { "type": "integer", "minimum": 1, "maximum": 10 },
          "lesson": { "type": "string", "minLength": 2, "maxLength": 40 },
          "kind": { "type": "string", "enum": ["board", "light", "joint", "drive", "arm", "sense", "reflex", "control", "path", "finish"] }
        }
      }
    }
  }
}
