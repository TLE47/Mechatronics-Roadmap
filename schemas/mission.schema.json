{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechalab.dev/schemas/mission.schema.json",
  "title": "MechaLab mission",
  "description": "One of the ten missions. It names a spine step rather than listing lessons: the lesson list is the route model's, joined in the app (app/src/gamification/missions.ts), so a mission can never disagree with the curriculum.",
  "type": "object",
  "required": [
    "number",
    "slug",
    "name",
    "chapter",
    "spineStep",
    "capability",
    "capabilityShort",
    "bossMoment",
    "toys",
    "doorLine",
    "recording",
    "clue"
  ],
  "additionalProperties": false,
  "properties": {
    "number": { "type": "integer", "minimum": 1, "maximum": 10 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 48 },
    "chapter": { "type": "string", "enum": ["I", "II", "III"] },
    "spineStep": { "type": "integer", "minimum": 1, "maximum": 10 },
    "capability": { "type": "string", "minLength": 6, "maxLength": 80 },
    "capabilityShort": { "type": "string", "minLength": 3, "maxLength": 28 },
    "bossMoment": { "type": "string", "minLength": 3, "maxLength": 48 },
    "toys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 }
    },
    "doorLine": { "type": "string", "minLength": 10, "maxLength": 140 },
    "recording": { "type": "string", "pattern": "^\\d\\d-[a-z0-9-]+$" },
    "clue": { "type": "string", "minLength": 3, "maxLength": 120 },
    "homeHotspot": { "type": "string", "enum": ["bench", "robot", "badge-wall", "window", "radio", "scrap-shelf", "back-room", "roof", "alley"] }
  }
}
