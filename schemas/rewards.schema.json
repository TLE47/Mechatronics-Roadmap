{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechalab.dev/schemas/rewards.schema.json",
  "title": "MechaLab reward rules",
  "description": "content/rewards/rules.yaml. Every number the reward engine uses is here, so tuning a reward is a reviewed pull request and not an app release. Nothing in this file may reward idle time, speed, randomness or payment.",
  "type": "object",
  "required": ["version", "levels", "proofMarks", "streetCred", "neon", "nightShifts"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "levels": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["number", "handle", "tagline", "earnedAt", "perks"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 0, "maximum": 10 },
          "handle": { "type": "string", "pattern": "^[A-Z0-9 ]{3,24}$" },
          "tagline": { "type": "string", "minLength": 6, "maxLength": 100 },
          "earnedAt": { "type": "string", "minLength": 3, "maxLength": 40 },
          "perks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                "label": { "type": "string", "minLength": 3, "maxLength": 60 },
                "kind": { "type": "string", "enum": ["surface", "toy", "room", "look", "audio", "flair"] }
              }
            }
          }
        }
      }
    },
    "proofMarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "earnedWhen", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 3, "maxLength": 32 },
          "earnedWhen": { "type": "string", "minLength": 8, "maxLength": 140 },
          "why": { "type": "string", "minLength": 8, "maxLength": 140 }
        }
      }
    },
    "streetCred": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "trigger", "scrap", "reward"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 3, "maxLength": 32 },
          "trigger": {
            "type": "string",
            "enum": [
              "first-verified",
              "three-predictions",
              "five-diagnostic-fixes",
              "hold-steady-verified",
              "first-fault-repair",
              "four-days-four-weeks",
              "ten-missions"
            ]
          },
          "scrap": { "type": "integer", "minimum": 0, "maximum": 20 },
          "reward": {
            "type": "object",
            "required": ["id", "label", "kind"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "label": { "type": "string", "minLength": 3, "maxLength": 60 },
              "kind": { "type": "string", "enum": ["sign", "decal", "skyline", "paint", "station", "crate", "lamp"] }
            }
          }
        }
      }
    },
    "neon": {
      "type": "object",
      "required": ["firstVerified", "review", "integration", "reRun", "hints"],
      "additionalProperties": false,
      "properties": {
        "firstVerified": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 },
        "integration": { "type": "integer", "minimum": 0 },
        "reRun": { "type": "integer", "minimum": 0, "maximum": 0 },
        "hints": { "type": "integer", "minimum": -10, "maximum": 0 }
      }
    },
    "nightShifts": {
      "type": "object",
      "required": ["defaultTarget", "weekStartsOn", "countsAs"],
      "additionalProperties": false,
      "properties": {
        "defaultTarget": { "type": "integer", "minimum": 1, "maximum": 7 },
        "weekStartsOn": { "type": "string", "enum": ["monday", "sunday"] },
        "countsAs": { "type": "string", "enum": ["meaningful-attempt"] }
      }
    }
  }
}
